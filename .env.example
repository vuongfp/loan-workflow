# Copy to .env and fill in. .env is ignored by git.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the site is served over HTTPS behind a proxy, e.g. https://lws.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production behind an HTTPS proxy: redirect to HTTPS, secure cookies, HSTS.
DJANGO_HTTPS=false
#DJANGO_HSTS_SECONDS=3600
#DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# Login session length in seconds (default: 8 hours).
#DJANGO_SESSION_SECONDS=28800
#DJANGO_LOG_LEVEL=INFO
# gunicorn worker processes (default 1); about 2 x CPU cores + 1.
#WEB_CONCURRENCY=3

# Used by both the Django app and the postgres container.
POSTGRES_DB=lws
POSTGRES_USER=lws
POSTGRES_PASSWORD=change-me
# Docker Compose overrides POSTGRES_HOST to "db" for the web service.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Lender details printed on generated loan contracts.
LENDER_NAME=
LENDER_ADDRESS=
# Business registration number and issuing authority.
LENDER_REGISTRATION=

# Outgoing email (SMTP). Defaults: localhost:25, no authentication.
# Use django.core.mail.backends.console.EmailBackend to print emails instead.
#DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=localhost
#EMAIL_PORT=25
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=false

# Demo data (python manage.py seed_demo): password of the demo users
# (sale1, ced1, approver1, cra1, ...) and the superuser it creates.
DEMO_USER_PASSWORD=change-me
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=change-me-too

# AI document reading (sends documents to the Anthropic API): off unless set to true,
# and only with the bank's approval. ANTHROPIC_API_KEY is read by the Anthropic SDK.
LWF_AI_DOCUMENT_READING=false
LWF_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# The API demo page (/api-demo/) suggests demo customers' ID numbers. Default: same as DJANGO_DEBUG.
# Keep it off where the data is real.
LWF_API_DEMO_SAMPLES=false
